# Скопируй в infra/.env и заполни.
# Этот файл подхватывается docker compose автоматически.

# --- Постгрес ---
POSTGRES_DB=aiconsult
POSTGRES_USER=aiconsult
POSTGRES_PASSWORD=aiconsult
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- chat-api (HTTP) и support-rt (WebSocket) ---
# 5000 на macOS часто занят (AirPlay Receiver). По умолчанию chat-api — 5001.
SERVER_PORT=5001
SUPPORT_RT_PORT=5040

# --- geo-service / stt-service / rag-svc ---
GEO_PORT=5010
STT_PORT=5020
RAG_PORT=5030

# --- JWT ---
JWT_SECRET_KEY=change-me-super-secret
JWT_EXPIRES_MINUTES=1440

# --- OpenRouter (обязательно) ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AIConsultTyumen
LLM_MAX_TOKENS=1800
LLM_TEMPERATURE=0.3

# --- RAG (pgvector) ---
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
RAG_TABLE_NAME=rag_chunks
RAG_TOP_K=4

# --- Yandex SpeechKit ---
YC_API_KEY=
YC_FOLDER_ID=

# --- паводок72 (OrbisMap) ---
ORBISMAP_BASE_URL=https://gis.72to.ru/orbismap/api/2.7/geoportal72/map29
ORBISMAP_PROXY_URL=

# --- Nominatim ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AIConsultTyumen/1.0 (admin@example.com)
