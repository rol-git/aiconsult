# Внутренний Caddy клиента: раздаёт собранную Vite-статику с SPA-fallback.
:80 {
	root * /srv
	encode gzip

	# Service worker и manifest не кешируем агрессивно
	@sw path /sw.js /manifest.webmanifest
	header @sw Cache-Control "no-cache"

	# Хешированные ассеты Vite — кешируем надолго
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}
