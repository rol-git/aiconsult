# По умолчанию фронт использует ОТНОСИТЕЛЬНЫЕ пути (/api, /socket.io, /stt).
# В dev их проксирует Vite (см. vite.config.ts), в проде — gateway (Caddy).
# Поэтому переменные ниже можно оставить ПУСТЫМИ.
#
# Заполняй их только если нужно прямое подключение к сервисам, минуя
# vite-proxy / gateway (например, фронт и бэкенд на разных хостах):
#
# VITE_API_URL=http://localhost:5001     # chat-api (HTTP)
# VITE_SOCKET_URL=http://localhost:5040  # support-rt (WebSocket)
# VITE_STT_URL=http://localhost:5020     # stt-service (распознавание речи)

VITE_API_URL=
VITE_SOCKET_URL=
VITE_STT_URL=
